APP_NAME=PRISM - Document Assurance Platform
DEBUG=false
CORS_ORIGINS=https://prism.reksolindo.co.id
CORS_ORIGIN_REGEX=^https://(?:[a-z0-9-]+\.)*reksolindo\.co\.id$
LOCAL_FALLBACK_EMAILS=

DATABASE_URL=postgresql+asyncpg://prism:prism@postgres:5432/prism
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

STORAGE_ROOT=./data
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=200
MAX_BATCH_SIZE=20
DOCUMENT_RETENTION_DAYS=90
MAX_DOCX_ENTRY_COUNT=1000
MAX_DOCX_UNCOMPRESSED_BYTES=209715200
MAX_DOCX_COMPRESSION_RATIO=100

AUTH_MODE=disabled
LANGUAGE_TOOL_HOST=http://languagetool:8081
TABLE_MATH_TOLERANCE_PERCENT=0.5
TABLE_MATH_TOLERANCE_UNIT=1.0
BIMA_BASE_URL=https://bima.reksolindo.co.id
BIMA_CLIENT_ID=prism
# Upstream HTTP behaviour. Set BIMA_SSL_VERIFY=false only for dev environments
# that must bypass an internal/expired certificate.
BIMA_TIMEOUT_SECONDS=15
BIMA_CONNECT_TIMEOUT_SECONDS=5
BIMA_SSL_VERIFY=true
