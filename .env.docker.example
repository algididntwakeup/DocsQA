# Optional host-port and database overrides for Docker Compose.
POSTGRES_DB=docqc
POSTGRES_USER=docqc
POSTGRES_PASSWORD=docqc
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000

# This value is compiled into the browser bundle during `docker compose build`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Authentication. Use a long random value on a server.
AUTH_MODE=required
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
