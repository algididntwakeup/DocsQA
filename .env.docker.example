# Optional host-port and database overrides for Docker Compose.
APP_NAME=PRISM - Document Assurance Platform
POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8001
FRONTEND_PORT=3001

# Browser requests use the same-origin Next.js proxy by default (/api/v1).
# If the frontend needs to hit a dedicated API origin directly (e.g. https://prism-api.reksolindo.id/api/v1), set it here:
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_URL=https://prism.reksolindo.co.id
INTERNAL_BACKEND_URL=http://backend:8000
CORS_ORIGINS=https://prism.reksolindo.co.id
CORS_ORIGIN_REGEX=^https://(?:[a-z0-9-]+\.)*reksolindo\.(?:co\.id|id)$
LOCAL_FALLBACK_EMAILS=
BIMA_BASE_URL=https://bima.reksolindo.co.id
BIMA_CLIENT_ID=prism

# Authentication. Use a long random value on a server.
AUTH_MODE=required
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
